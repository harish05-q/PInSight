# Database
DATABASE_URL=postgresql+asyncpg://pinsight:pinsight@postgres:5432/pinsight
DATABASE_URL_SYNC=postgresql://pinsight:pinsight@postgres:5432/pinsight

# Redis
REDIS_URL=redis://redis:6379/0

# Groq API
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# App
ENV=development
LOG_LEVEL=INFO
